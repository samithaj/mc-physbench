# Long random string; signs logins and file links and encrypts stored RunPod keys.
HJS_SECRET_KEY=change-me
# Public HTTPS URL of this server; GPU pods call back to it.
HJS_PUBLIC_URL=https://studio.example.com
# runpod: rent GPUs on RunPod. local: run workers as subprocesses on this host (dev / own GPU box).
HJS_LAUNCHER=runpod
# Platform-paid RunPod key (optional if every user brings their own key in Settings).
RUNPOD_API_KEY=
# Worker image built from worker/Dockerfile and pushed to a registry RunPod can pull.
HJS_WORKER_IMAGE=ghcr.io/samithaj/hjepa-worker:latest
POSTGRES_PASSWORD=change-me-too
# Optional limits
HJS_MAX_CONCURRENT_JOBS=3
HJS_DEFAULT_MAX_HOURS=6
HJS_MAX_HOURS_LIMIT=48
HJS_SESSION_IDLE_MINUTES=20
HJS_ALLOW_REGISTRATION=true
